# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# --- Project: machine-specific config ---
# Defaults live in config/default_config.json and ARE committed.
# config.json holds per-machine calibration and must not be.
config/config.json
config/*.local.json

# --- Project: models ---
# The MediaPipe bundle is a ~7.5 MB binary; fetch it with
# scripts/download_model.ps1 instead of committing it.
models/*.task
models/*.tflite
models/*.onnx
models/*.pkl
models/*.joblib
!models/.gitkeep

# --- Project: recorded data (privacy) ---
# Landmark datasets and any camera recordings are personal biometric data.
data/**
!data/.gitkeep

# --- Project: debug output ---
logs/
*.log
debug_output/
captures/
*.mp4
*.avi
